[{"start": 0.34, "end": 5.24, "text": " Sebelum kita tamatkan borak hari ini, kita simpulkan tiga perkara.", "words": [{"s": 0.34, "e": 1.32, "w": " Sebelum"}, {"s": 1.32, "e": 1.6, "w": " kita"}, {"s": 1.6, "e": 2.08, "w": " tamatkan"}, {"s": 2.08, "e": 2.42, "w": " borak"}, {"s": 2.42, "e": 2.76, "w": " hari"}, {"s": 2.76, "e": 3.1, "w": " ini,"}, {"s": 3.2, "e": 3.5, "w": " kita"}, {"s": 3.5, "e": 4.06, "w": " simpulkan"}, {"s": 4.06, "e": 4.44, "w": " tiga"}, {"s": 4.44, "e": 5.24, "w": " perkara."}]}, {"start": 5.66, "end": 10.48, "text": " Pertama, kerancuan bahasa bukan sekadar percapanan perkataan,", "words": [{"s": 5.66, "e": 6.58, "w": " Pertama,"}, {"s": 6.78, "e": 7.22, "w": " kerancuan"}, {"s": 7.22, "e": 7.72, "w": " bahasa"}, {"s": 7.72, "e": 8.18, "w": " bukan"}, {"s": 8.18, "e": 8.76, "w": " sekadar"}, {"s": 8.76, "e": 9.44, "w": " percapanan"}, {"s": 9.44, "e": 10.48, "w": " perkataan,"}]}, {"start": 10.58, "end": 15.28, "text": " malah boleh melibatkan pengaruh bahasa asing terhadap surat Tok Ayat.", "words": [{"s": 10.58, "e": 11.02, "w": " malah"}, {"s": 11.02, "e": 11.34, "w": " boleh"}, {"s": 11.34, "e": 11.94, "w": " melibatkan"}, {"s": 11.94, "e": 12.3, "w": " pengaruh"}, {"s": 12.3, "e": 12.64, "w": " bahasa"}, {"s": 12.64, "e": 13.32, "w": " asing"}, {"s": 13.32, "e": 13.88, "w": " terhadap"}, {"s": 13.88, "e": 14.14, "w": " surat"}, {"s": 14.14, "e": 14.32, "w": " Tok"}, {"s": 14.32, "e": 15.28, "w": " Ayat."}]}, {"start": 15.42, "end": 22.76, "text": " Kedua, bahasa rojak dan ragam tidak formal perlu dilihat berdasarkan konteks, kejuan dan kesesuaiannya.", "words": [{"s": 15.42, "e": 15.96, "w": " Kedua,"}, {"s": 16.44, "e": 16.82, "w": " bahasa"}, {"s": 16.82, "e": 17.3, "w": " rojak"}, {"s": 17.3, "e": 17.54, "w": " dan"}, {"s": 17.54, "e": 18.02, "w": " ragam"}, {"s": 18.02, "e": 18.4, "w": " tidak"}, {"s": 18.4, "e": 18.96, "w": " formal"}, {"s": 18.96, "e": 19.34, "w": " perlu"}, {"s": 19.34, "e": 19.84, "w": " dilihat"}, {"s": 19.84, "e": 20.34, "w": " berdasarkan"}, {"s": 20.34, "e": 21.02, "w": " konteks,"}, {"s": 21.16, "e": 21.66, "w": " kejuan"}, {"s": 21.66, "e": 21.92, "w": " dan"}, {"s": 21.92, "e": 22.76, "w": " kesesuaiannya."}]}, {"start": 22.76, "end": 29.84, "text": " Ketiga, guru memainkan peranan penting dalam membimbing murid menguasai bahasa maibaku", "words": [{"s": 22.76, "e": 24.54, "w": " Ketiga,"}, {"s": 24.7, "e": 25.14, "w": " guru"}, {"s": 25.14, "e": 25.82, "w": " memainkan"}, {"s": 25.82, "e": 26.08, "w": " peranan"}, {"s": 26.08, "e": 26.6, "w": " penting"}, {"s": 26.6, "e": 26.88, "w": " dalam"}, {"s": 26.88, "e": 27.4, "w": " membimbing"}, {"s": 27.4, "e": 28.02, "w": " murid"}, {"s": 28.02, "e": 28.7, "w": " menguasai"}, {"s": 28.7, "e": 29.04, "w": " bahasa"}, {"s": 29.04, "e": 29.84, "w": " maibaku"}]}, {"start": 29.84, "end": 35.2, "text": " tanpa merendahkan variasi bahasa yang digunakan dalam kehidupan seharian.", "words": [{"s": 29.84, "e": 30.44, "w": " tanpa"}, {"s": 30.44, "e": 31.46, "w": " merendahkan"}, {"s": 31.46, "e": 31.96, "w": " variasi"}, {"s": 31.96, "e": 32.82, "w": " bahasa"}, {"s": 32.82, "e": 33.1, "w": " yang"}, {"s": 33.1, "e": 33.62, "w": " digunakan"}, {"s": 33.62, "e": 33.94, "w": " dalam"}, {"s": 33.94, "e": 34.38, "w": " kehidupan"}, {"s": 34.38, "e": 35.2, "w": " seharian."}]}, {"start": 35.72, "end": 44.76, "text": " Dari sudut sintaksis, kita perlu memahami bagaimana perkataan disesun untuk membentuk perasa, klausah dan ayat yang dramatis.", "words": [{"s": 35.72, "e": 36.16, "w": " Dari"}, {"s": 36.16, "e": 36.46, "w": " sudut"}, {"s": 36.46, "e": 37.4, "w": " sintaksis,"}, {"s": 37.78, "e": 38.12, "w": " kita"}, {"s": 38.12, "e": 38.44, "w": " perlu"}, {"s": 38.44, "e": 39.18, "w": " memahami"}, {"s": 39.18, "e": 39.88, "w": " bagaimana"}, {"s": 39.88, "e": 40.48, "w": " perkataan"}, {"s": 40.48, "e": 41.08, "w": " disesun"}, {"s": 41.08, "e": 41.52, "w": " untuk"}, {"s": 41.52, "e": 42.04, "w": " membentuk"}, {"s": 42.04, "e": 42.88, "w": " perasa,"}, {"s": 43.12, "e": 43.56, "w": " klausah"}, {"s": 43.56, "e": 43.72, "w": " dan"}, {"s": 43.72, "e": 44.0, "w": " ayat"}, {"s": 44.0, "e": 44.28, "w": " yang"}, {"s": 44.28, "e": 44.76, "w": " dramatis."}]}, {"start": 47.22, "end": 51.98, "text": " Penguasaan sistem ini membantu kita menyampaikan maksud dengan lebih tepat.", "words": [{"s": 47.22, "e": 47.9, "w": " Penguasaan"}, {"s": 47.9, "e": 48.28, "w": " sistem"}, {"s": 48.28, "e": 48.7, "w": " ini"}, {"s": 48.7, "e": 49.18, "w": " membantu"}, {"s": 49.18, "e": 49.56, "w": " kita"}, {"s": 49.56, "e": 50.3, "w": " menyampaikan"}, {"s": 50.3, "e": 50.78, "w": " maksud"}, {"s": 50.78, "e": 51.08, "w": " dengan"}, {"s": 51.08, "e": 51.36, "w": " lebih"}, {"s": 51.36, "e": 51.98, "w": " tepat."}]}, {"start": 51.98, "end": 55.06, "text": " Dan, aku pula belajar satu benda.", "words": [{"s": 51.98, "e": 52.7, "w": " Dan,"}, {"s": 52.94, "e": 53.22, "w": " aku"}, {"s": 53.22, "e": 53.58, "w": " pula"}, {"s": 53.58, "e": 53.86, "w": " belajar"}, {"s": 53.86, "e": 54.1, "w": " satu"}, {"s": 54.1, "e": 55.06, "w": " benda."}]}, {"start": 55.68, "end": 58.44, "text": " Roti canai boleh rojak dengan kuah.", "words": [{"s": 55.68, "e": 55.86, "w": " Roti"}, {"s": 55.86, "e": 56.68, "w": " canai"}, {"s": 56.68, "e": 57.1, "w": " boleh"}, {"s": 57.1, "e": 57.5, "w": " rojak"}, {"s": 57.5, "e": 57.88, "w": " dengan"}, {"s": 57.88, "e": 58.44, "w": " kuah."}]}, {"start": 58.62, "end": 63.32, "text": " Tapi, ayat untuk tugasan jangan sampai rojak tak tentu hala.", "words": [{"s": 58.62, "e": 59.34, "w": " Tapi,"}, {"s": 59.84, "e": 59.98, "w": " ayat"}, {"s": 59.98, "e": 60.3, "w": " untuk"}, {"s": 60.3, "e": 60.92, "w": " tugasan"}, {"s": 60.92, "e": 61.38, "w": " jangan"}, {"s": 61.38, "e": 61.92, "w": " sampai"}, {"s": 61.92, "e": 62.46, "w": " rojak"}, {"s": 62.46, "e": 62.66, "w": " tak"}, {"s": 62.66, "e": 62.86, "w": " tentu"}, {"s": 62.86, "e": 63.32, "w": " hala."}]}, {"start": 66.82, "end": 69.48, "text": " Itu perumpamaan untuk kita.", "words": [{"s": 66.82, "e": 67.74, "w": " Itu"}, {"s": 67.74, "e": 68.66, "w": " perumpamaan"}, {"s": 68.66, "e": 69.02, "w": " untuk"}, {"s": 69.02, "e": 69.48, "w": " kita."}]}, {"start": 70.12, "end": 73.78, "text": " Terima kasih kerana bersama-sama mendengar bicara bahasa.", "words": [{"s": 70.12, "e": 70.44, "w": " Terima"}, {"s": 70.44, "e": 70.9, "w": " kasih"}, {"s": 70.9, "e": 71.32, "w": " kerana"}, {"s": 71.32, "e": 71.88, "w": " bersama"}, {"s": 71.88, "e": 72.18, "w": "-sama"}, {"s": 72.18, "e": 72.72, "w": " mendengar"}, {"s": 72.72, "e": 73.16, "w": " bicara"}, {"s": 73.16, "e": 73.78, "w": " bahasa."}]}, {"start": 74.28, "end": 79.06, "text": " Semoga perbualan sentai ini memberi manfaat dan membuatkan kita lebih berker", "words": [{"s": 74.28, "e": 74.52, "w": " Semoga"}, {"s": 74.52, "e": 75.12, "w": " perbualan"}, {"s": 75.12, "e": 75.44, "w": " sentai"}, {"s": 75.44, "e": 76.18, "w": " ini"}, {"s": 76.18, "e": 76.76, "w": " memberi"}, {"s": 76.76, "e": 77.26, "w": " manfaat"}, {"s": 77.26, "e": 77.54, "w": " dan"}, {"s": 77.54, "e": 78.0, "w": " membuatkan"}, {"s": 78.0, "e": 78.26, "w": " kita"}, {"s": 78.26, "e": 78.64, "w": " lebih"}, {"s": 78.64, "e": 79.06, "w": " berker"}]}, {"start": 79.06, "end": 81.48, "text": " terhadap penguasaan bahasa Melayu.", "words": [{"s": 79.06, "e": 79.88, "w": " terhadap"}, {"s": 79.88, "e": 80.64, "w": " penguasaan"}, {"s": 80.64, "e": 80.94, "w": " bahasa"}, {"s": 80.94, "e": 81.48, "w": " Melayu."}]}, {"start": 81.48, "end": 86.94, "text": " Saya Naim, bersama Fadli dan Adam.", "words": [{"s": 81.48, "e": 82.64, "w": " Saya"}, {"s": 82.64, "e": 83.44, "w": " Naim,"}, {"s": 83.66, "e": 84.9, "w": " bersama"}, {"s": 84.9, "e": 85.8, "w": " Fadli"}, {"s": 85.8, "e": 86.34, "w": " dan"}, {"s": 86.34, "e": 86.94, "w": " Adam."}]}, {"start": 87.54, "end": 89.72, "text": " Assalamualaikum dan salam sejahtera.", "words": [{"s": 87.54, "e": 88.34, "w": " Assalamualaikum"}, {"s": 88.34, "e": 88.72, "w": " dan"}, {"s": 88.72, "e": 89.06, "w": " salam"}, {"s": 89.06, "e": 89.72, "w": " sejahtera."}]}, {"start": 90.74, "end": 91.48, "text": " Waalaikumsalam.", "words": [{"s": 90.74, "e": 91.48, "w": " Waalaikumsalam."}]}, {"start": 92.12, "end": 93.38, "text": " Waalaikumsalam.", "words": [{"s": 92.12, "e": 93.38, "w": " Waalaikumsalam."}]}, {"start": 95.5, "end": 96.76, "text": " Waalaikumsalam.", "words": [{"s": 95.5, "e": 96.76, "w": " Waalaikumsalam."}]}]